/* Settings tab, Return page and compact flight bar of the new window (plan 2026-11-19-new-ui-tab-migration).
   Settings and Return rules are scoped under .ssa-app. The compact flight bar (AppHudView) lives in the window's
   host, outside .ssa-app: its rules are scoped under .ssa-hud and spell their colours (the variables of .ssa-app
   do not reach it). Sizes are the mockups' pixels (settings.svg, return.svg, hud.svg) times 0.85. */

/* ---- SETTINGS (settings.svg) ---- */
.ssa-app .ssa-settings .ssa-col--plan { width: 255px; min-width: 220px; }
.ssa-app.ssa-app--narrow .ssa-settings .ssa-col--plan { width: 48%; }
.ssa-app .ssa-settings .ssa-category:hover Label.ssa-category__label { color: var(--text); }
.ssa-app .ssa-settings .ssa-category--active:hover Label.ssa-category__label { color: var(--gold-light); }
.ssa-app .ssa-settings .ssa-switch { height: 44px; }
.ssa-app .ssa-settings .ssa-setting .ssa-dropdown { margin-bottom: 0; }
.ssa-app .ssa-settings .ssa-setting .ssa-slider { margin-bottom: 0; }

/* The shortcut, shown in a field box like the mockup's drop-down (it is rebound in Redux's mod settings). */
.ssa-app .ssa-settings-key {
    height: 41px;
    border-width: 1px;
    border-radius: 8.5px;
    border-color: var(--edge);
    background-color: var(--night);
    padding: 0 17px;
    justify-content: center;
}
.ssa-app Label.ssa-settings-key__text { font-size: 14px; color: var(--text); }

.ssa-app Label.ssa-settings-about__title { font-size: 13px; color: var(--text); white-space: normal; margin-bottom: 4px; }
.ssa-app .ssa-settings-credit { flex-direction: row; align-items: flex-start; min-height: 22px; margin-bottom: 4px; flex-shrink: 0; }
.ssa-app Label.ssa-settings-credit__who { font-size: 12px; color: var(--gold-light); width: 36%; flex-shrink: 0; white-space: normal; -unity-font-definition: var(--font-strong); margin-right: 10px; }
.ssa-app Label.ssa-settings-credit__what { font-size: 12px; color: var(--muted); flex-grow: 1; flex-shrink: 1; flex-basis: 0; white-space: normal; }
.ssa-app Label.ssa-settings-thanks { font-size: 12px; color: var(--muted); white-space: normal; margin-bottom: 6px; }

/* About card (right column). */
.ssa-app .ssa-settings-logo { width: 115px; height: 115px; align-self: center; margin-top: 10px; }
.ssa-app Label.ssa-about__line.ssa-settings-version { color: var(--node); font-size: 12px; }
.ssa-app Label.ssa-about__line.ssa-settings-link { color: var(--cyan); margin-top: 10px; }
.ssa-app Label.ssa-about__line.ssa-settings-link:hover { color: var(--text); }

/* ---- RETURN (return.svg), a planned page: every control disabled ---- */
.ssa-app .ssa-return .ssa-return--disabled:disabled { opacity: 0.55; }
.ssa-app .ssa-return .ssa-button.ssa-return--disabled:disabled { opacity: 0.45; }
.ssa-app .ssa-return .ssa-return__planned { margin-top: 0; margin-bottom: 8px; min-height: 32px; }
.ssa-app .ssa-return .ssa-switch { height: 33px; }
.ssa-app .ssa-return .ssa-button-row { margin-bottom: 4px; }
.ssa-app .ssa-return-box {
    min-height: 50px;
    border-width: 1px;
    border-radius: 8.5px;
    border-color: var(--line);
    background-color: var(--night);
    padding: 7px 17px;
    margin-bottom: 8px;
    justify-content: center;
    flex-shrink: 0;
}
.ssa-app .ssa-return-box--gold { border-color: var(--gold); }
.ssa-app Label.ssa-return-box__title { font-size: 13.5px; color: var(--text); -unity-font-definition: var(--font-strong); }
.ssa-app Label.ssa-return-box__detail { font-size: 10.5px; color: var(--muted); margin-top: 4px; white-space: normal; }
.ssa-app .ssa-return-found {
    flex-direction: row;
    align-items: center;
    min-height: 42px;
    border-width: 1px;
    border-radius: 8.5px;
    border-color: #3d6b2a;
    background-color: #132a1e;
    padding: 0 17px;
    margin-bottom: 10px;
    flex-shrink: 0;
}
.ssa-app Label.ssa-return-found__text { font-size: 12px; color: var(--ok); white-space: normal; flex-grow: 1; flex-shrink: 1; flex-basis: 0; }
.ssa-app .ssa-return .ssa-field__label { margin-bottom: 6px; }
.ssa-app .ssa-return-check { flex-direction: row; align-items: center; height: 26px; flex-shrink: 0; }
.ssa-app Label.ssa-return-check__text { font-size: 12px; color: var(--text); }
.ssa-app .ssa-return__timeline { opacity: 0.6; }

/* The profile view: drawn in code (ReturnProfileView), labels placed by it. */
.ssa-app .ssa-return-view { flex-grow: 1; min-height: 200px; margin: 6px 0 22px 0; }
.ssa-app Label.ssa-return-view__label { position: absolute; font-size: 10px; }
.ssa-app Label.ssa-return-view__label--gold { color: var(--gold-light); }
.ssa-app Label.ssa-return-view__label--alert { color: var(--alert); }
.ssa-app Label.ssa-return-view__label--node { color: var(--node); }
.ssa-app Label.ssa-return-view__label--data { color: var(--cyan); }

/* ---- Compact flight bar (hud.svg), outside .ssa-app ---- */
.ssa-hud {
    position: absolute;
    top: 72px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    height: 82px;
    min-width: 560px;
    max-width: 1020px;
    padding: 0 12px 0 19px;
    border-width: 2px;
    border-radius: 15px;
    border-color: #2a3a78;
    background-color: #0e1840;
    -unity-background-scale-mode: stretch-to-fill;
    -unity-font-definition: url("project://database/Packages/ksp2redux.sdk/Controls/Assets/Theme/Fonts/NotoSans/NotoSans-Regular%20SDF.asset?fileID=11400000&guid=13518dd9ae3a52c4abe48648d2401d8b&type=2#NotoSans-Regular SDF");
}
.ssa-hud Label {
    color: #f4f7ff;
    font-size: 12px;
    padding: 0;
    margin: 0;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Packages/ksp2redux.sdk/Controls/Assets/Theme/Fonts/NotoSans/NotoSans-Regular%20SDF.asset?fileID=11400000&guid=13518dd9ae3a52c4abe48648d2401d8b&type=2#NotoSans-Regular SDF");
}
.ssa-hud .ssa-hud__badge { width: 41px; height: 41px; margin-right: 13px; flex-shrink: 0; }
.ssa-hud__main { flex-direction: row; align-items: center; flex-grow: 1; flex-shrink: 1; }
.ssa-hud__title { width: 128px; flex-shrink: 0; }
.ssa-hud Label.ssa-hud__pilot { font-size: 11px; color: #8ea3d6; letter-spacing: 1.7px; }
.ssa-hud Label.ssa-hud__phase {
    font-size: 17px;
    color: #ffe29a;
    margin-top: 2px;
    -unity-font-definition: url("project://database/Packages/ksp2redux.sdk/Controls/Assets/Theme/Fonts/NotoSans/NotoSans-SemiBold%20SDF.asset?fileID=11400000&guid=39b10ce5dcbae2448ba06bb2f960e478&type=2#NotoSans-SemiBold SDF");
}

/* Phase dots: gold for the phases flown, a gold ring for the current one, dark for the rest. */
.ssa-hud__dots { flex-direction: row; align-items: center; margin: 0 14px 0 4px; flex-shrink: 0; }
.ssa-hud__dot { width: 11px; height: 11px; border-radius: 5.5px; background-color: #1d2c66; flex-shrink: 0; }
.ssa-hud__dot--done { background-color: #e8a93a; }
.ssa-hud__dot--current { width: 17px; height: 17px; border-radius: 8.5px; border-width: 2.5px; border-color: #ffe29a; background-color: #0a1230; }
.ssa-hud__link { width: 20px; height: 2px; background-color: #1d2c66; flex-shrink: 0; }
.ssa-hud__link--done { background-color: #e8a93a; }

.ssa-hud__sep { width: 1px; height: 46px; background-color: #24366e; margin: 0 20px 0 12px; flex-shrink: 0; }
.ssa-hud__readouts { flex-direction: row; align-items: center; flex-shrink: 1; }
.ssa-hud__readout { width: 140px; flex-shrink: 1; }
.ssa-hud Label.ssa-hud__label { font-size: 10px; color: #8ea3d6; letter-spacing: 0.5px; }
.ssa-hud Label.ssa-hud__value {
    font-size: 19px;
    color: #f4f7ff;
    margin-top: 3px;
    -unity-font-definition: url("project://database/Packages/ksp2redux.sdk/Controls/Assets/Theme/Fonts/NotoSans/NotoSans-SemiBold%20SDF.asset?fileID=11400000&guid=39b10ce5dcbae2448ba06bb2f960e478&type=2#NotoSans-SemiBold SDF");
}
.ssa-hud__gauge { width: 150px; margin-right: 12px; flex-shrink: 0; }
.ssa-hud__gauge-line { flex-direction: row; align-items: center; margin-top: 8px; }
.ssa-hud__gauge-track { width: 102px; height: 10px; border-radius: 5px; background-color: #1d2c66; }
.ssa-hud__gauge-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 5px; background-color: #7fe7ff; }
.ssa-hud Label.ssa-hud__gauge-value { font-size: 11px; margin-left: 8px; }

.ssa-hud__button { width: 39px; height: 39px; border-radius: 8px; border-width: 1px; margin-left: 9px; flex-shrink: 0; }
.ssa-hud__button--stop { background-color: #3a1a1a; border-color: #7a3030; }
.ssa-hud__button--open { background-color: #1d2c66; border-color: #2c3f80; }
.ssa-hud__button:hover { border-color: #8ea3d6; }
.ssa-hud__button:disabled { opacity: 0.45; }

/* Alert: the bar turns coral while a guard acts (hud.svg, right). */
.ssa-hud--alert { border-color: #ff7a5a; background-color: #2e1012; }
.ssa-hud__alert { flex-direction: row; align-items: center; flex-grow: 1; flex-shrink: 1; }
.ssa-hud__alert-dot { width: 17px; height: 17px; border-radius: 8.5px; background-color: #ff7a5a; margin-right: 14px; flex-shrink: 0; }
.ssa-hud Label.ssa-hud__alert-text {
    font-size: 13.5px;
    color: #ffd9cc;
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    -unity-font-definition: url("project://database/Packages/ksp2redux.sdk/Controls/Assets/Theme/Fonts/NotoSans/NotoSans-SemiBold%20SDF.asset?fileID=11400000&guid=39b10ce5dcbae2448ba06bb2f960e478&type=2#NotoSans-SemiBold SDF");
}
.ssa-hud Label.ssa-hud__alert-detail { font-size: 12px; color: #ffd9cc; margin: 0 8px 0 16px; flex-shrink: 0; }
